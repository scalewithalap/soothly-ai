{
  "meta": {
    "brand_name": "Soothly AI",
    "description": "A premium multi-agent AI SaaS platform.",
    "visual_language": "Trustworthy Futurist",
    "color_scheme": "dark"
  },
  "colors": {
    "base": {
      "obsidian": "#080808",
      "gunmetal": "#030014",
      "background": "#080808",
      "foreground": "#FFFFFF"
    },
    "primary": {
      "DEFAULT": "#9382FF",
      "hover": "#7B6AF0",
      "foreground": "#030014"
    },
    "secondary": {
      "DEFAULT": "#F4F4F5",
      "foreground": "#18181B"
    },
    "accent": {
      "indigo": "#9382FF",
      "violet": "#8B5CF6",
      "deep": "#030014",
      "gradient": "linear-gradient(135deg, #9382FF, #8B5CF6)"
    },
    "semantic": {
      "success": "#10B981",
      "warning": "#F59E0B",
      "destructive": "#EF4444",
      "muted": "#F4F4F5",
      "link": "#030014"
    },
    "glass": {
      "border": "rgba(255, 255, 255, 0.1)",
      "background": "rgba(255, 255, 255, 0.05)",
      "hover_border": "rgba(255, 255, 255, 0.2)",
      "hover_background": "rgba(255, 255, 255, 0.1)"
    },
    "dark": {
      "background": "#080808",
      "foreground": "#F4F0FF",
      "muted": "#27272A",
      "border": "rgba(255, 255, 255, 0.1)"
    }
  },
  "typography": {
    "font_family_headings": ["Host Grotesk", "sans-serif"],
    "font_family_body": ["Manrope", "sans-serif"],
    "font_family_mono": ["JetBrains Mono", "monospace"],
    "heading_tracking": "-0.02em",
    "font_weight_bold": "700",
    "font_weight_medium": "500",
    "font_weight_normal": "400"
  },
  "ui": {
    "border_radius_default": "8px",
    "border_radius_small": "4px",
    "border_radius_full": "9999px",
    "spacing_base_unit": "4",
    "glassmorphism": {
      "backdrop_blur": "blur(12px)",
      "border_width": "1px"
    },
    "components": {
      "input": {
        "background": "transparent",
        "text_color": "#F4F0FF",
        "border_color": null,
        "border_radius": "0px",
        "border_radius_corners": {
          "top_left": "0px",
          "top_right": "0px",
          "bottom_right": "0px",
          "bottom_left": "0px"
        },
        "shadow": "none"
      }
    }
  }
}
