# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# Communication
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Payments (Polar)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
# sandbox | production (decoupled from NODE_ENV so prod deploys can pilot on sandbox)
POLAR_SERVER=sandbox
# Product IDs from your Polar dashboard - one per tier/interval
POLAR_PRODUCT_LAUNCH_MONTHLY=
POLAR_PRODUCT_LAUNCH_YEARLY=
POLAR_PRODUCT_GROWTH_MONTHLY=
POLAR_PRODUCT_GROWTH_YEARLY=
POLAR_PRODUCT_SCALE_MONTHLY=
POLAR_PRODUCT_SCALE_YEARLY=

# Scraping
APIFY_API_TOKEN=

# Plivo (SMS/WhatsApp)
PLIVO_AUTH_ID=your_id
PLIVO_AUTH_TOKEN=your_token
PLIVO_SENDER_NUMBER=+1234567890
PLIVO_WHATSAPP_NUMBER=+1234567890

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=